    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sample GMM: synthetic_data_creation.py",
            "type": "debugpy",
            "request": "launch",
            "module": "synthetic_data.synthetic_data_creation",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--seed", "42"
            ]
        },
        {
            "name": "create_dataset_infomec (sort-easy-2goals-v0)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/VPL/pref_learn/create_dataset_infomec.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/VPL",
            "args": [
                "--env=sort-easy-2goals-v0",
                // "--offline_dataset_h5=/scr/yutaizho/code/p-disentangle/Disentangled_Reward_Learning/data/ravens/sort-easy-2goals-v0/_vpl_official/rollout_dataset.hdf5",
                "--offline_dataset_h5=/scr/yutaizho/code/p-disentangle/Disentangled_Reward_Learning/data/ravens/sort-easy-2goals-v0/20260517_211957_ntrajs=20/rollout_dataset.hdf5",
                "--data_seed=42",
                "--num_query=100",
                "--segment_len=1",
                "--set_size=16",
                "--debug=True"
            ]
        },
        {
            "name": "create_dataset_infomec (sort-easy-4goals-v0)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/VPL/pref_learn/create_dataset_infomec.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/VPL",
            "args": [
                "--env=sort-easy-4goals-v0",
                // "--offline_dataset_h5=/scr/yutaizho/code/p-disentangle/Disentangled_Reward_Learning/data/ravens/sort-easy-2goals-v0/_vpl_official/rollout_dataset.hdf5",
                // "--offline_dataset_h5=/scr/yutaizho/code/p-disentangle/Disentangled_Reward_Learning/data/ravens/sort-easy-2goals-v0/20260517_211957_ntrajs=20/rollout_dataset.hdf5",
                "--offline_dataset_h5=/scr/yutaizho/code/p-disentangle/Disentangled_Reward_Learning/data/ravens/sort-easy-4goals-v0/20260517_212722_ntrajs=5000/rollout_dataset.hdf5",
                "--data_seed=42",
                "--num_query=100",
                "--segment_len=1",
                "--set_size=16",
                "--debug=True"
            ]
        },

        {
            "name": "plot_infomec",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/VPL/scripts/plot_infomec.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/VPL",
            "args": [
                "--input-dir",
                "/scr/yutaizho/code/p-disentangle/Disentangled_Reward_Learning/VPL/logs3/sort-easy-v0/VAEClassifier/20260424_214120_ld=8/7_beta=100.0_ld=8",
                "--split",
                "eval"
            ]
        },
        {
            "name": "plot_infomec_sweep",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/VPL/scripts/plot_infomec_sweep.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/VPL",
            "args": [
                "--input-dir",
                "/scr/yutaizho/code/p-disentangle/Disentangled_Reward_Learning/VPL/logs3/sort-easy-v0/VAE/20260426_064854_ld=8_learned-Prior=False/" ,
                "--split", "eval"
            ]
        },
        {
            "name": "train VAE",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/VPL/pref_learn/train.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/VPL",
            "env": {
                "WANDB_MODE": "disabled"
            },
            "args": [
                // Mirrors VPL/scripts/submit_train_vae.bash (local run ≈ Slurm array task 0: β=0.0001).
                "--pref_dataset=sort_2goals_T=1",
                // "--pref_dataset=sort_4goals_T=10",
                "--model_type=VAE",
                "--comment=debug_00_beta=0.0001",
                "--latent_dim=4",
                "--kl_weight=0.0001",
                "--learned_prior=True",
                "--use_annealing=False",
                "--seed=42",
                "--batch_size=256",
                "--n_epochs=500",
                "--eval_freq=50",
                "--save_freq=50",
                "--device=cuda",
                "--logging.output_dir=${workspaceFolder}/outputs",
                "--logging.online=False"
            ]
        }
    ]
}